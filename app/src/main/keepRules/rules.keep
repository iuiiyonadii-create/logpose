# 1. Blindaje Spotify SDK
-keep class com.spotify.** { *; }
-dontwarn com.spotify.**
-dontwarn com.fasterxml.jackson.**
-keepattributes *Annotation*

# 2. Blindaje Google Crypto & Tink
-keep class com.google.crypto.tink.** { *; }
-dontwarn com.google.crypto.tink.**
-dontwarn com.google.errorprone.annotations.**
-dontwarn javax.annotation.**

# 3. Forzar Ofuscación Staff (Excepto el punto de entrada)
-keep class com.uriel.logpose.core.app.MainActivity { *; }
-keep class com.uriel.logpose.core.app.LogPoseApplication { *; }
